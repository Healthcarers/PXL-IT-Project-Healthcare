# Extract real client IP behind Azure Container Apps Envoy / private proxies
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 100.64.0.0/10;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# L7 DDoS & brute-force protection zones (per real client IP)
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=${AUTH_RATE_LIMIT};
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=${API_RATE_LIMIT};
limit_conn_zone $binary_remote_addr zone=per_ip_conn:10m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    server_tokens off;
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;

    resolver ${RESOLVER_IP} valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    # Lightweight gateway health probe
    location = /healthz {
        access_log off;
        include /etc/nginx/snippets/security-headers.conf;
        default_type application/json;
        return 200 '{"status":"UP"}';
    }

    # Strict rate limiting on authentication endpoints (brute-force / DDoS shield)
    location /api/auth/ {
        limit_req zone=auth_limit burst=${AUTH_BURST} nodelay;
        limit_conn per_ip_conn ${MAX_CONNS_PER_IP};
        limit_req_status 429;
        limit_conn_status 429;

        include /etc/nginx/snippets/security-headers.conf;

        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name "${API_HOST}";
        proxy_ssl_verify off;
        proxy_set_header Host "${API_HOST}";
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # General API reverse proxy with L7 flood protection
    location /api/ {
        limit_req zone=api_limit burst=${API_BURST} nodelay;
        limit_conn per_ip_conn ${MAX_CONNS_PER_IP};
        limit_req_status 429;
        limit_conn_status 429;

        include /etc/nginx/snippets/security-headers.conf;

        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name "${API_HOST}";
        proxy_ssl_verify off;
        proxy_set_header Host "${API_HOST}";
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # STOMP WebSocket reverse proxy
    location /ws {
        limit_conn per_ip_conn ${MAX_CONNS_PER_IP};
        limit_conn_status 429;

        include /etc/nginx/snippets/security-headers.conf;

        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name "${API_HOST}";
        proxy_ssl_verify off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host "${API_HOST}";
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Static assets cache
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Vue SPA history fallback
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
